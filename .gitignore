# Local .terraform directories
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars
.terraform.lock.hcl

# Override files (local-only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
tfplan

# CLI configuration files
.terraformrc
terraform.rc

# tf-migrate generated files
_hcp-migrate-configs/
_hcp-migrate-configs/*
_hcp-migrate-configs*/*


# Editor / OS files
.DS_Store
.idea/
.vscode/
*.swp

# Env files and local secrets
.env
.env.
# These lines were added by the tf-migrate CLI tool
_hcp-migrate-configs-*/
!_hcp-migrate-configs*/terraform.tfstate
.terraform.lock.*
